# Copia este archivo a ".env" y ajusta los valores antes de desplegar en producción.

# Puerto en el que arrancará el servidor (Render/Railway lo asignan automáticamente).
PORT=3000

# Clave secreta para firmar las sesiones. Usa un valor largo y aleatorio en producción.
# Puedes generar uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=cambia-este-secreto-en-produccion
